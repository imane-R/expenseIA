# Données : seules les données explicitement anonymisées ou d'exemple sont suivies
*.xlsx
*.xls
*.xlsm
!**/*_example.xlsx
!**/*_anonymized.xlsx
!**/*_example.xls
!**/*_anonymized.xls
!**/*_example.xlsm
!**/*_anonymized.xlsm
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/README.md
!data/processed/README.md
!data/raw/*_example.*
!data/raw/*_anonymized.*
!data/processed/*_example.*
!data/processed/*_anonymized.*

